# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://apktevzfdgritpmqhrir.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

