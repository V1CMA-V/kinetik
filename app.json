{
  "expo": {
    "name": "Kinetik",
    "slug": "kinetik",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kinetik",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.vicma.kinetik"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.vicma.kinetik"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Kinetik usa Face ID para proteger tu información financiera."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#208AEF"
        }
      ],
      "expo-quick-actions",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "QuickAdd",
              "label": "Kinetik",
              "description": "Agrega gastos e ingresos rápido",
              "minWidth": "250dp",
              "minHeight": "40dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeHeight": "180dp",
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widgets/quick-add-preview.png",
              "updatePeriodMillis": 21600000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
